# Normalize line endings across platforms (LF in repo, LF on checkout).
# https://git-scm.com/docs/gitattributes

* text=auto eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.jar binary
*.webp binary
*.png binary
*.jpg binary
*.gif binary
